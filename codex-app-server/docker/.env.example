# docker-compose.agent.yml 专用环境变量。
# 从 Dify 完整 .env 中提取出本 compose 文件实际引用的变量。
# 其余 Dify 配置已舍弃；如需完整配置请参考原 Dify docker/.env。
# host 网络模式下，SHELLCTL_ENTRYPOINT / STUB_API_BASE_URL 会被 compose 内联覆盖为 localhost。
# 复制本文件为 .env 并填入你自己的密钥：cp .env.example .env

# ---- Redis ----
REDIS_PASSWORD=<your-redis-password>

# ---- Plugin daemon ----
EXPOSE_PLUGIN_DAEMON_PORT=5002
PLUGIN_DAEMON_PORT=5002
PLUGIN_DAEMON_KEY=<your-plugin-daemon-key>
PLUGIN_DAEMON_URL=http://plugin_daemon:5002

# ---- Dify 内部 API（供插件回调）----
PLUGIN_DIFY_INNER_API_KEY=<your-dify-inner-api-key>
PLUGIN_DIFY_INNER_API_URL=http://api:5001

# ---- Dify Agent backend ----
DIFY_AGENT_API_TOKEN=<your-agent-api-token>
DIFY_AGENT_REDIS_URL=
DIFY_AGENT_REDIS_PREFIX=dify-agent
DIFY_AGENT_SHUTDOWN_GRACE_SECONDS=30
DIFY_AGENT_RUN_RETENTION_SECONDS=259200
# 留空 = 由 PLUGIN_DAEMON_URL/KEY 推导
DIFY_AGENT_PLUGIN_DAEMON_URL=
DIFY_AGENT_PLUGIN_DAEMON_API_KEY=
# 留空 = 由 PLUGIN_DIFY_INNER_API_URL/KEY 推导
DIFY_AGENT_INNER_API_URL=
DIFY_AGENT_INNER_API_KEY=
DIFY_AGENT_SHELLCTL_ENTRYPOINT=http://local_sandbox:5004
DIFY_AGENT_SHELLCTL_AUTH_TOKEN=
DIFY_AGENT_STUB_API_BASE_URL=http://agent_backend:5050/agent-stub
DIFY_AGENT_SERVER_SECRET_KEY=<your-server-secret-key>

# ---- codex-app-server ----
# 日志等级：error | request | output
CODEX_API_LOG_LEVEL=output
