# codex-app-server 配置文件。程序启动时默认读取当前目录的 .env，
# 可用 -config <path> 或 CODEX_API_CONFIG 指定其他路径。
# 真实环境变量优先于本文件中的同名条目。

# 监听地址
CODEX_API_LISTEN_IP=0.0.0.0
CODEX_API_PORT=5040

# 接口地址后缀，默认 /api -> POST /api/messages 等
CODEX_API_PREFIX=api

# 日志等级：error | request | output
CODEX_API_LOG_LEVEL=request

# API key（Bearer）。留空或不写 = 不要求鉴权
# CODEX_API_AUTH_TOKEN=

# 固定工作目录。留空 = 由接口参数决定（cwd > app_id/user_id > 此值 > 进程目录）
# CODEX_API_WORK_DIR=

# app_id/user_id 路径的基底：<base>/<app_id>/workspace/<user_id>
# 默认 ./home（即程序目录下的 home/）。Docker 里通常设为 /home
CODEX_API_WORKSPACE_BASE=./home

# SQLite 数据库路径（conversation_id <-> thread_id 映射）
CODEX_API_DB=./codex-app-server.db

# codex 二进制路径
CODEX_API_BIN=codex

# 审批策略：never | onRequest | onFailure | unlessTrusted
# never = 不需要人工审批（对应旧 --yolo）
CODEX_API_APPROVAL_POLICY=never

# 沙箱模式：dangerFullAccess | workspaceWrite | readOnly
# dangerFullAccess = 完全访问（对应旧 --yolo）
CODEX_API_SANDBOX=dangerFullAccess

# 完全不受限模式（docker 沙盒内推荐开启）。
# 等效于旧 codex exec --yolo：强制 dangerFullAccess + never 审批，
# 覆盖上面的 SANDBOX 和 APPROVAL_POLICY 设置。
# 同时给 codex app-server 进程传入 -c sandbox_mode/approval_policy 默认值。
# CODEX_API_YOLO=true

# 模型覆盖；留空 = 用 codex 配置的默认模型
# CODEX_API_MODEL=

# CODEX_HOME（认证和会话数据，thread 持久化依赖它），默认 ~/.codex
# CODEX_API_CODEX_HOME=

# app-server 子进程的 HOME，默认 ~
# CODEX_API_HOME=

# 注入给 codex 子进程的环境变量：CODEX_API_ENV_FOO=bar -> FOO=bar
# CODEX_API_ENV_RUST_LOG=off
